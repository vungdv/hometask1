      "realmRoles": ["offline_access", "uma_authorization", "customer-success", "customer_success"],
      "clientRoles": { "account": ["view-profile", "manage-account"] }
    },
    {
      "username": "customer-success",
      "enabled": true, "emailVerified": true,
      "firstName": "Customer", "lastName": "Success",
      "email": "customer-success@novagadgets.local",
      "credentials": [{ "type": "password", "value": "testpass", "temporary": false }],
      "realmRoles": ["offline_access", "uma_authorization", "customer-success", "customer_success"],
