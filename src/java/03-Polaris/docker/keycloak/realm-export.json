{
  "realm": "polaris",
  "enabled": true,
  "clients": [
    {
      "clientId": "polaris-app",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "https://polaris.local/swagger-ui/index.html",
        "https://polaris.local/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "https://polaris.local"
      ],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "web-origins",
        "catalog.read",
        "order.read",
        "order.write"
      ]
    },
    {
      "clientId": "polaris-local",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:8080/swagger-ui/index.html",
        "http://localhost:8080/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "web-origins",
        "catalog.read",
        "order.read",
        "order.write"
      ]
    },
    {
      "clientId": "polaris-mcp",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://127.0.0.1:*",
        "http://localhost:*",
        "http://127.0.0.1:8085/oauth/callback",
        "http://localhost:8085/oauth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "web-origins",
        "catalog.read",
        "order.read",
        "order.write"
      ]
    },
    {
      "clientId": "grafana",
      "name": "Grafana Observability",
      "enabled": true,
      "publicClient": false,
      "secret": "grafana-client-secret",
      "redirectUris": [
        "https://grafana.polaris.local/login/generic_oauth",
        "http://localhost:3000/login/generic_oauth",
        "http://127.0.0.1:3000/login/generic_oauth"
      ],
      "webOrigins": [
        "https://grafana.polaris.local",
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    }
  ],
  "clientScopes": [
    {
      "name": "catalog.read",
      "description": "Read access to the product catalog — search products and look up SKUs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "View product catalog"
      }
    },
    {
      "name": "order.read",
      "description": "Read access to orders — status checks, full details, and order history",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "View your orders"
      }
    },
    {
      "name": "order.write",
      "description": "Write access to orders — place new orders and cancel existing ones",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Place and cancel orders on your behalf"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin"
      },
      {
        "name": "editor"
      },
      {
        "name": "viewer"
      }
    ],
    "client": {
      "grafana": [
        {
          "name": "admin",
          "clientRole": true
        },
        {
          "name": "editor",
          "clientRole": true
        },
        {
          "name": "viewer",
          "clientRole": true
        }
      ]
    }
  },
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "testuser@novagadgets.local",
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "offline_access",
        "uma_authorization",
        "admin"
      ],
      "clientRoles": {
        "account": [
          "view-profile",
          "manage-account"
        ],
        "grafana": [
          "admin"
        ]
      }
    }
  ]
}