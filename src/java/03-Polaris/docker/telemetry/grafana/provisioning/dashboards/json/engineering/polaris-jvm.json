    {
      "id": 6,
      "type": "timeseries",
      "title": "Heap used vs committed vs max",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (exported_job)(jvm_memory_used_bytes{exported_job=~\"$service\",area=\"heap\"})",
          "legendFormat": "{{exported_job}} used",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (exported_job)(jvm_memory_committed_bytes{exported_job=~\"$service\",area=\"heap\"})",
          "legendFormat": "{{exported_job}} committed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (exported_job)(jvm_memory_max_bytes{exported_job=~\"$service\",area=\"heap\"} > 0)",
          "legendFormat": "{{exported_job}} max",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
