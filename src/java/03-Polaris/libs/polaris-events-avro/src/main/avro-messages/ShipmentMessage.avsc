{
  "type": "record",
  "name": "ShipmentMessage",
  "namespace": "vn.danang.polaris.events.avro.fulfilment",
  "doc": "The whole Kafka message value on polaris.fulfilment.shipments: event metadata plus the ShipmentEvent payload. Subject polaris.fulfilment.shipments-value holds this schema.",
  "fields": [
    {"name": "id", "type": "string", "doc": "Event id (OutgoingEvent.id)."},
    {"name": "type", "type": "string", "doc": "Event type, e.g. vn.danang.polaris.fulfilment.shipment.packed.v1 (OutgoingEvent.type)."},
    {"name": "source", "type": "string", "doc": "Producing context, e.g. /polaris/fulfilment (OutgoingEvent.source)."},
    {"name": "time", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "When the event was recorded (OutgoingEvent.time)."},
    {"name": "data", "type": "vn.danang.polaris.events.avro.fulfilment.ShipmentEvent"}
  ]
}
