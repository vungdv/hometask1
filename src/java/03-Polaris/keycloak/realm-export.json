{
  "realm": "polaris",
  "enabled": true,
  "clients": [
    {
      "clientId": "polaris-app",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "https://polaris.local/swagger-ui/index.html",
        "https://polaris.local/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "https://polaris.local"
      ],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "polaris-local",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:8080/swagger-ui/index.html",
        "http://localhost:8080/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "polaris-mcp",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://127.0.0.1:*",
        "http://localhost:*",
        "http://127.0.0.1:8085/oauth/callback",
        "http://localhost:8085/oauth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "testuser@novagadgets.local",
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ],
      "realmRoles": ["offline_access", "uma_authorization"],
      "clientRoles": {
        "account": ["view-profile", "manage-account"]
      }
    }
  ]
}